# Puerto en el que escucha el servicio.
PORT=3000

# Origen del frontend autorizado a llamar a esta API.
# En producción, la URL del despliegue; en local, el servidor de Vite.
CORS_ORIGIN=http://localhost:5173

# Clave para el interruptor de estado (PUT /admin/status).
# Obligatoria: sin ella el servicio no arranca. Cámbiala en producción.
ADMIN_KEY=clave-de-desarrollo-no-usar-en-produccion

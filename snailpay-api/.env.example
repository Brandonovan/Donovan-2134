# Puerto en el que escucha el servicio.
PORT=3000

# Origen del frontend autorizado a llamar a esta API.
# En producción, la URL del despliegue; en local, el servidor de Vite.
CORS_ORIGIN=http://localhost:5173

# Milisegundos que tarda la autorización simulada, con una variación de +-20%.
# Un cobro real no es instantáneo: la pasarela espera al banco emisor. En 0
# responde al instante, útil para pruebas automatizadas.
AUTHORIZATION_DELAY_MS=1200

# Mientras no exista el backend del comercio, el navegador lo simula (ver
# features/wallet/merchant). Ponlo en false cuando ese backend exista.
VITE_USE_MOCKS=true

# URL del backend del comercio. Solo se usa con VITE_USE_MOCKS=false.
# VITE_API_URL=https://api.ejemplo.com

# URL de la pasarela de pagos (snailpay-api). Si se deja vacía, el comercio
# simulado también simula el cobro, y el front funciona sin levantarla.
# VITE_GATEWAY_URL=http://localhost:3000
